# Скопируйте в backend/.env и вставьте свои ключи. Все опциональны.
# .env в .gitignore — в репозиторий не попадёт.

# github.com/settings/tokens -> Generate new token (classic), без скоупов.
# Лимит GitHub API: 5000 req/час вместо 60 (ф.5).
GITHUB_TOKEN=

# etherscan.io/myapikey (бесплатно). Кошельки команды + smart money (ф.7, ф.11).
ETHERSCAN_API_KEY=

# console.anthropic.com -> API keys. Классификация Discord «по существу vs шум» (ф.12).
ANTHROPIC_API_KEY=
# CLASSIFY_MODEL=claude-opus-5

# cryptopanic.com/developers/api (бесплатный тариф). Доп. новости к GDELT (ф.10).
CRYPTOPANIC_TOKEN=

# defillama.com/pro — платный. Автоматические фандинг-раунды и разлоки
# вместо ручного ввода в projects.yaml (ф.4, ф.7).
DEFILLAMA_API_KEY=
